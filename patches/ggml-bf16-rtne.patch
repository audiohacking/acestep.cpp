diff --git a/src/ggml-cuda/unary.cu b/src/ggml-cuda/unary.cu
index 4cb805fa..2df664ed 100644
--- a/src/ggml-cuda/unary.cu
+++ b/src/ggml-cuda/unary.cu
@@ -114,6 +114,19 @@ static __device__ __forceinline__ float op_trunc(float x) {
     return trunc(x);
 }
 
+// F32->BF16->F32 round-trip, round-to-nearest-even (same rule as
+// ggml_compute_fp32_to_bf16 / PyTorch's bf16 cast), staying F32-typed.
+static __device__ __forceinline__ float op_bf16_rtne(float x) {
+    const uint32_t u = __float_as_uint(x);
+    uint32_t bits;
+    if ((u & 0x7fffffffu) > 0x7f800000u) { // NaN
+        bits = (u >> 16) | 64u; // force to quiet
+    } else {
+        bits = (u + (0x7fffu + ((u >> 16) & 1u))) >> 16;
+    }
+    return __uint_as_float(bits << 16);
+}
